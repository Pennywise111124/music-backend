# PHẦN 5. GENRE - PHÂN QUYỀN
# ############################################################

### GN5. User thường tạo genre -> 403
POST {{baseUrl}}/api/admin/genres
Authorization: Bearer {{loginUser.response.body.accessToken}}
Content-Type: application/json

{ "name": "Pop" }

### GN6. Không token tạo genre -> 401
POST {{baseUrl}}/api/admin/genres
Content-Type: application/json

{ "name": "Pop" }

### GN7. Token rác tạo genre -> 401
POST {{baseUrl}}/api/admin/genres
Authorization: Bearer token.rac.khong.hop.le
Content-Type: application/json

{ "name": "Pop" }

