# ############################################################
# PHẦN 42. RECENTLY PLAYED - XÁC THỰC VÀ GHI NHẬN
# ############################################################

### RP1. User xem lịch sử lúc đầu -> 200, mảng rỗng
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP2. Không token xem -> 401
GET {{baseUrl}}/api/recently-played

### RP3. Không token ghi nhận -> 401
POST {{baseUrl}}/api/recently-played/{{rpSong1.response.body.id}}

### RP4. User nghe song 1 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong1.response.body.id}}
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP5. User nghe song 2 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong2.response.body.id}}
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP6. User nghe song 3 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong3.response.body.id}}
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP7. Lịch sử -> 200, 3 phần tử, thứ tự: RP Three, RP Two, RP One
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP8. User nghe lại song 1 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong1.response.body.id}}
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP9. Lịch sử -> 200, vẫn 3 phần tử (không trùng), thứ tự: RP One, RP Three, RP Two
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP10. Song không tồn tại -> 404
POST {{baseUrl}}/api/recently-played/999999
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP11. songId sai kiểu -> 400
POST {{baseUrl}}/api/recently-played/abc
Authorization: Bearer {{loginUser.response.body.accessToken}}

# ############################################################
# PHẦN 43. RECENTLY PLAYED - TÁCH BIỆT GIỮA CÁC USER
# ############################################################

### RP12. Lịch sử của admin -> 200, mảng rỗng (không thấy của user)
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP13. Admin nghe song 2 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong2.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP14. Lịch sử của user -> 200, vẫn 3 phần tử, thứ tự không đổi (RP One, RP Three, RP Two)
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP15. Lịch sử của admin -> 200, chỉ RP Two
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

# ############################################################
# PHẦN 44. RECENTLY PLAYED - XÓA LỊCH SỬ
# ############################################################

### RP16. Không token xóa -> 401
DELETE {{baseUrl}}/api/recently-played

### RP17. User xóa lịch sử -> 204
DELETE {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP18. Lịch sử của user -> 200, rỗng
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP19. Lịch sử của admin -> 200, vẫn còn RP Two (RP17 không xóa nhầm của admin)
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP20. User xóa lại khi đã rỗng -> 204 (idempotent)
DELETE {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP21. User nghe lại song 1 -> 204
POST {{baseUrl}}/api/recently-played/{{rpSong1.response.body.id}}
Authorization: Bearer {{loginUser.response.body.accessToken}}

# ############################################################
# PHẦN 45. RECENTLY PLAYED - XÓA SONG CÓ TRONG LỊCH SỬ VÀ DỌN DẸP
# ############################################################

### RP22. Admin xóa song 1 (user đang có trong lịch sử) -> 204, KHÔNG được ra 409/500
DELETE {{baseUrl}}/api/admin/songs/{{rpSong1.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP23. Lịch sử của user -> 200, rỗng (đã dọn theo song)
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginUser.response.body.accessToken}}

### RP24. Admin xóa song 2 (admin đang có trong lịch sử) -> 204
DELETE {{baseUrl}}/api/admin/songs/{{rpSong2.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP25. Lịch sử của admin -> 200, rỗng
GET {{baseUrl}}/api/recently-played
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP26. Admin xóa song 3 -> 204
DELETE {{baseUrl}}/api/admin/songs/{{rpSong3.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### RP27. Admin xóa artist -> 204
DELETE {{baseUrl}}/api/admin/artists/{{rpArtist.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

