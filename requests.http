Authorization: Bearer {{loginAdmin.response.body.accessToken}}
Content-Type: application/json

{ "title": "Up One Renamed", "artistId": {{upArtist.response.body.id}}, "albumId": {{upAlbum.response.body.id}}, "durationMs": 120000, "audioUrl": "http://hack/x.mp3" }

