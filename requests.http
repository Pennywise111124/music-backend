### RP0a. Artist -> 201
# @name rpArtist
POST {{baseUrl}}/api/admin/artists
Authorization: Bearer {{loginAdmin.response.body.accessToken}}
Content-Type: application/json

{ "name": "RP Artist" }

### RP0b. Song 1 -> 201
# @name rpSong1
POST {{baseUrl}}/api/admin/songs
Authorization: Bearer {{loginAdmin.response.body.accessToken}}
Content-Type: multipart/form-data; boundary=UpB

--UpB
Content-Disposition: form-data; name="metadata"
Content-Type: application/json

{ "title": "RP One", "artistId": {{rpArtist.response.body.id}}, "durationMs": 100000 }
--UpB
Content-Disposition: form-data; name="audio"; filename="a.mp3"
Content-Type: audio/mpeg

< ./test-files/a.mp3
--UpB--

